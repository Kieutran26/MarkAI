{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/activity",
      "regex": "^/activity(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/activity(?:/)?$"
    },
    {
      "page": "/blog",
      "regex": "^/blog(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/blog(?:/)?$"
    },
    {
      "page": "/deploy",
      "regex": "^/deploy(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/deploy(?:/)?$"
    },
    {
      "page": "/lessons",
      "regex": "^/lessons(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/lessons(?:/)?$"
    },
    {
      "page": "/modules",
      "regex": "^/modules(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/modules(?:/)?$"
    },
    {
      "page": "/nav-manage",
      "regex": "^/nav\\-manage(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/nav\\-manage(?:/)?$"
    },
    {
      "page": "/prompts",
      "regex": "^/prompts(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/prompts(?:/)?$"
    },
    {
      "page": "/settings",
      "regex": "^/settings(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/settings(?:/)?$"
    },
    {
      "page": "/ticker",
      "regex": "^/ticker(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/ticker(?:/)?$"
    },
    {
      "page": "/tips",
      "regex": "^/tips(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/tips(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}